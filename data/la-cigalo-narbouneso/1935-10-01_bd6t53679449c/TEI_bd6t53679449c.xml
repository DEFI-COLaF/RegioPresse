  <text>
    <body>
      <div type="article">
        <div>
          <pb facs="0008.xml"/>
          <milestone unit="page" n="152"/>
          <ab><lb/>CABIROU</ab>
          <p rend="heading"><lb/>CABIROU</p>
          <p rend="styled"><lb/>Lou bandit !....</p>
          <lg>
            <l><lb/>Cinq cents francs ! quinze jours ! lou gusas I la canalho!</l>
            <l><lb/>Pardi de moun argent Moussu fara ripalho,</l>
            <l><lb/>Acos ’s acos la lé!... es quicon de poulit.</l>
            <l><lb/>Auiots cent cops rasou que siots roustit, boulit !...</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Que bos!</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Lou sacripant !... la michanto bestiasso</l>
            <l><lb/>leu que pendent bint ans ei biscut dins la crasso,</l>
            <l><lb/>Qu’ei soufert lou martir per estr' al pun que sioi,</l>
            <l><lb/>Aquel poulit Moussu d’un aïrè pla galoï</l>
            <l><lb/>Mé bendro peltira ço qu’ei dins la tireto!...</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Alors las pas coumprès?....</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Si mé la trapi réto I</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Cependant moun amic, as pas rasou, lou mal....</l>
          </lg>
          <lg>
            <l><lb/>!... lou cal soulacha !...</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Pardi !... qu’un animal,</l>
            <l><lb/>A pas encaro bist qu’acos’s uno carotto !...</l>
            <l><lb/>Gar aïssis Balenti.</l>
          </lg>
          <p rend="heading"><lb/>SENO XVII</p>
          <p rend="heading"><lb/>CABIROU, PIERROUNEL, BALENTI</p>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Moussu porti la noto,</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>La noio?...</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Oui Moussu I... Moussu lou sous-prefet</l>
            <l><lb/>Ben de me la bàlha en diguen: c’est bien fait !...</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>C'est bien fait ?...</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Oui Moussu «Et je suis en colère,</l>
            <l><lb/>S'il ne beut pas pager je l'embois en galère »</l>
          </lg>
          <pb facs="0009.xml"/>
          <milestone unit="page" n="153"/>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Aï moundius !...</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Dequ'abets?...</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <list>
            <item>Parès I... O lou brigant !....</item>
          </list>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Escoutats « Cabirou beut relever le gant.</l>
            <l><lb/>Et bien, dites lui bien que nous abons des armes,</l>
            <l><lb/>Et que s’il pague pas. il y a les gendarmes»</l>
            <l><lb/>Bous counseilli Moussu de paga d’al pus lèu.</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Sabi pas dequé fa I....</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Pagats Moussu !...</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <p rend="styled"><lb/>Qu'un flèu !....</p>
          <lg>
            <l><lb/>Aprèts abé trimat uno santo bidasso.</l>
          </lg>
          <p rend="heading"><lb/>BaLENtI</p>
          <lg>
            <l><lb/>Pagats Moussu !... pagats !...</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <list>
            <item>Aï boudius que m’agasso.</item>
          </list>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Cé que lou sous prefet m’a dit « Botre patron,</l>
            <l><lb/>De la main a la main peut paguer ce garçon»</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Ce garçon?...</l>
          </lg>
          <p rend="heading"><lb/>BalentI</p>
          <lg>
            <l><lb/>Oui Moussu.</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Boulho diré à Canilho</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>E m'a dit di pourta qui metro l'estampilho,</l>
            <l><lb/>Lou reçu de l’argent.</l>
          </lg>
          <p rend="heading"><lb/>CARIROU</p>
          <lg>
            <l><lb/>As rasou Balenti,</l>
            <l><lb/>A tous rasounoments coumençi de senti</l>
            <l><lb/>Que se pagabi pas me faïon de misèros.</l>
          </lg>
          <ab><lb/>BALENTI</ab>
          <lg>
            <l><lb/>Oui Moussu.</l>
          </lg>
          <pb facs="0010.xml"/>
          <milestone unit="page" n="154"/>
          <ab><lb/>Es ço qué boli fairé.<lb/>Ajès pas poù l’amic faren pas de soutisos.</ab>
          <lg>
            <l><lb/>CABIROU</l>
            <l><lb/>Cinq cents francs !...</l>
          </lg>
          <figure type="table"/>
          <p rend="heading"><lb/>BALENTI</p>
          <p rend="heading"><lb/>Faguets pas de manièros<lb/>Pagats sé boulèts pas qué bous métoun dèdin.</p>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Cinq cents francs I...</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <list>
            <item>Es la lé !...</item>
          </list>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Calho-te margoulin !...</l>
          </lg>
          <lg>
            <l><lb/>Pagarei se mé plaï.</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Acos es toun afaïré.</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Pagats !... Moussu pagats !...</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Alumo-mé lou lun qu’ané serca l’argent</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Aquis l'abets Moussu I....</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <ab><lb/>Merci (semba)</ab>
          <p rend="heading"><lb/>SENO XVIII</p>
          <p rend="heading"><lb/>PIERROUNIL, BALENTI, CANILHO</p>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Es lou moument</l>
          </lg>
          <lg>
            <l><lb/>Se boulen reussi de pas fa de bestisos,</l>
          </lg>
          <p rend="heading"><lb/>CANILHO</p>
          <p rend="heading"><lb/>BALENTI</p>
          <list>
            <item>L'aben encatelat coum’un catèl de fial.</item>
          </list>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Y a bits que de blu.</l>
          </lg>
          <p rend="heading"><lb/>CANILHO</p>
          <lg>
            <l><lb/>Pourtara ço que cal I....</l>
          </lg>
          <lg>
            <l><lb/>Ce porto ço que cal !... Brounchen pas d’uno ligno.</l>
            <l><lb/>leu am’aquel argent croumparei uno bigno.</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <p rend="heading"><lb/>CANILHO</p>
          <pb facs="0020.xml"/>
        </div>
      </div>
    </body>
  </text>
