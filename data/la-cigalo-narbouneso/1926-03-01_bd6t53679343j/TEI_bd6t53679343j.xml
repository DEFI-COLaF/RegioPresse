  <text>
    <body>
      <div>
        <pb facs="0001.xml"/>
        <dateline><lb/>MARS 1926</dateline>
        <dateline><lb/>X ANNADO</dateline>
        <fw type="numbering">No 98</fw>
        <ab><lb/>C.A.D.O.<lb/>BEZIERS</ab>
        <ab><lb/>NaRBOuNeSO<lb/>Revisto Artistico, Literario e Risoulieiro<lb/>Engimbado pes Felibres dal Narbounes<lb/>CANTO CADO MES<lb/><lb/><lb/>ET<lb/>ALCIMADURO<lb/>Pastouralo Langedoucièno<lb/><lb/>de CASSANEA de MONDONVILLE<lb/>Abounoment : 12 fr. per an.<lb/>Tirage de Luxe: 24 francs per an<lb/><lb/><lb/><lb/><lb/><lb/><lb/></ab>
        <ab><lb/>DA PHNIS</ab>
        <ab><lb/>Narbouno — Estampariè dal Lengadoc, A. BRIEU. 4. Carrieiro Auber, 4<fw type="digitisation-artefact"><lb/>ce alica.nf.f/CIRDOC-Mediatèa occitna</fw></ab>
        <pb facs="0011.xml"/>
        <milestone unit="page" n="41"/>
        <p rend="heading"><milestone unit="column" n="1"/><lb/>SCENO V</p>
        <p rend="heading"><lb/>DAPHNIS, ALCIMADURO,<lb/>PASTOUS, PASTOUROS, PASTRES</p>
        <p rend="heading"><lb/>DAPHNIS</p>
        <lg>
          <l><lb/>Per playr' à ma bélo Pastouro,</l>
          <l><lb/>Benéts, mous jantis coumpagnous.</l>
          <l><lb/>L'amour ayci fa sa demouro,</l>
          <l><lb/>Dansats, dansats, trémoussats bous.</l>
        </lg>
        <ab><milestone unit="column" n="2"/><lb/>On danso.</ab>
        <p rend="heading"><lb/>Chor</p>
        <lg>
          <l><lb/>Coumo lou lum de la naturo</l>
          <l><lb/>Forço d’ésclore milo flous,</l>
          <l><lb/>Tabé lous éls d’Alcimaduro</l>
          <l><lb/>Forçoun lous cors d’éstr’amourous.</l>
        </lg>
        <p rend="styled"><lb/>On danso.</p>
        <p rend="heading"><lb/>DAPHNIS</p>
        <p rend="heading"><lb/>Air</p>
        <lg>
          <l><lb/>Qui béy la bél'Alcimaduro</l>
          <l><lb/>Béy l'astre lou pu bél,</l>
          <l><lb/>Per charma touto la naturo</l>
          <l><lb/>Nou li cal qu’un cop d’él.</l>
          <l><lb/>Per aquélo Bénus noubélo</l>
          <l><lb/>On béy lous amours enfantéts</l>
          <l><lb/>Boultija sans céss' aprés élo</l>
          <l><lb/>Coum’uno troupo d'auzeléts.</l>
          <l><lb/>Qui béy, etc.</l>
        </lg>
      </div>
      <div type="article">
        <head><lb/>DAPHNIS</head>
        <head><lb/>Air</head>
        <lg>
          <l><lb/>Bezéts l’ourmél per las flourétos</l>
          <l><lb/>Boulega sous joüines raméls.</l>
          <l><lb/>Escoutats das pichots auzéls</l>
          <l><lb/>Las amourousos cansounétos.</l>
          <l><lb/>Per tout charma lou Diu nenet</l>
          <l><lb/>Tiro sans césso de l'arquét,</l>
          <l><lb/>N’oublido rés dins la naturo</l>
          <l><lb/>Hormis lou cor d’Alcimaduro,</l>
        </lg>
      </div>
      <div type="article">
        <fw type="quiremarks"><lb/>On danso.</fw>
        <p rend="styled"><lb/>On danso.</p>
        <pb facs="0012.xml"/>
        <ab><milestone unit="column" n="1"/><lb/>42<lb/></ab>
      </div>
      <div type="article">
        <head><lb/>DAPHNIS</head>
        <head><lb/>air</head>
        <lg>
          <l><lb/>Poulido Pastourélo,</l>
          <l><lb/>Perléto das amous,</l>
          <l><lb/>De la Roso noubélo</l>
          <l><lb/>Esfaçats las coulous ;</l>
          <l><lb/>Perqué siéts bous tan bélo ?</l>
          <l><lb/>E yéu tan amourous!</l>
          <l><lb/>Poulido Pastourélo,</l>
          <l><lb/>Perléto das amous;</l>
          <l><lb/>Ben que me siats cruélo,</l>
          <l><lb/>Yéu n’aymaréy que bous.</l>
        </lg>
        <ab type="head"><lb/>DAPHNIS É LOU CHOR</ab>
        <lg>
          <l><lb/>Al Diu d'amour rés nou pot resista...</l>
        </lg>
        <ab type="head"><lb/>ALCIMADURO</ab>
        <lg>
          <l><lb/>Bous celebrats trop la tendrésso,</l>
          <l><lb/>Perqué tan souben la canta ?</l>
        </lg>
        <ab type="head"><lb/>DAPHNIS</ab>
        <lg>
          <l><lb/>Quand on la cant'à sa mestrèsso,</l>
          <l><lb/>On nou pot trop la repeta.</l>
        </lg>
        <ab type="head"><lb/>air</ab>
        <lg>
          <l><lb/>Daphnis nou cerquo qu’à bous playre,</l>
          <l><lb/>Aco ’s tout soun countentomen,</l>
          <l><lb/>Nou troubaréts jamay fringayre,</l>
          <l><lb/>Que bous ayme pu tendromen.</l>
        </lg>
        <ab type="head"><lb/>AlciMADuRo</ab>
        <lg>
          <l><lb/>M’en cal ana trouba moun frayre.</l>
          <l><lb/>Excusats moun empréssomen.</l>
        </lg>
        <ab type="head"><lb/>DAPHNIS</ab>
        <lg>
          <l><lb/>Elo s’en ba coum’un ésclayre.</l>
          <l><lb/>Amour, ben feni moun tourmen.</l>
        </lg>
        <ab type="head"><lb/>FIN DÉL PRuMIER ACTE</ab>
        <p rend="styled"><lb/>On danso.</p>
        <pb facs="0013.xml"/>
        <ab><lb/>— 43</ab>
        <p rend="heading"><lb/>actE SEGoun</p>
        <p rend="styled"><lb/>Lou théâtre répresento lous<lb/>entours del hamél d’ALCIMADURO,<lb/>das oustals d’un coustat, das albres<lb/>de l'autre é dins lou foun un bosc.</p>
        <p rend="heading"><lb/>SCÉNO I</p>
        <p rend="heading"><lb/>JEANET habillat en milicien. TROUPO DE PASTOUS</p>
        <p rend="heading"><lb/>JEANET E LOU CHOR</p>
        <lg>
          <l><lb/>Per trioumpha dél loup salbatge</l>
          <l><lb/>Que desolo nostre cantou,</l>
          <l><lb/>Amics, anen, prengan couratge,</l>
          <l><lb/>Fazen brilla nostro balou.</l>
        </lg>
        <p rend="heading"><lb/>JEANET</p>
        <lg>
          <l><lb/>Per li douna dedins la panso,</l>
          <l><lb/>Anats toutis vous prépara.</l>
          <l><lb/>Quand caldra coumença la danso,</l>
          <l><lb/>Un de vous aus m’abertira.</l>
        </lg>
        <p rend="heading"><lb/>SCENO II</p>
        <p rend="heading"><lb/>JEANET</p>
        <lg>
          <l><lb/>Per Daphnis, l'habit de miliço</l>
          <l><lb/>Es un déguisomen noubél.</l>
          <l><lb/>Boli li rendre un boun oufiço,</l>
          <l><lb/>Se soun amour és pla fidél.</l>
          <l><lb/>Més, aprocho d’ayci.</l>
        </lg>
        <ab><lb/>Dins lou tens que Daphnis arribo,<lb/>Jeanet se mét a léscar.</ab>
        <p rend="heading"><lb/>SCENO III</p>
        <p rend="heading"><lb/>DAPHNIS, JEANET a léscar</p>
        <p rend="heading"><lb/>DAPHNIS</p>
        <p rend="heading"><lb/>Air</p>
        <lg>
          <l><lb/>Hélas ! qui me raméno</l>
          <l><lb/>Dedins aquesté loc !</l>
          <l><lb/>Nou beni que cerqua de peno</l>
          <l><lb/>Sensé poudé calma moun foc</l>
        </lg>
        <pb facs="0023.xml"/>
        <milestone unit="page" n="53"/>
        <ab><lb/>Eh ! coussi me calma?</ab>
        <p rend="heading"><lb/>SCENO IV</p>
        <p rend="heading"><lb/>ALCIMADURO</p>
        <lg>
          <l><lb/>Lou cruél m’abandouno!</l>
          <l><lb/>El fugits, el s’en ba, que fa ? Que débéni ?</l>
          <l><lb/>Alcimadur', hélas ! nou pot lou réténi !</l>
          <l><lb/>Moun ésprit és troublat é tout moun cor frissouno.</l>
          <l><lb/>Moun frayr’, oun te siats, bous? aribats proumptomen,</l>
          <l><lb/>Alcimaduro bous apélo.</l>
          <l><lb/>Qu’aquél retardomen</l>
          <l><lb/>A ma doulou cruélo</l>
          <l><lb/>Ajouto de tourmen,</l>
        </lg>
        <p rend="heading"><lb/>SCENO V</p>
        <p rend="heading"><lb/>ALCIMADURO, JEANET</p>
        <p rend="heading"><lb/>ALCIMADURO</p>
        <lg>
          <l><lb/>Ah ! Jeanet. déspechats, béléu Daphnis trépasso,</l>
          <l><lb/>Anats, couréts prés d’él...</l>
        </lg>
        <p rend="heading"><lb/>JEANET</p>
        <list>
          <item>O secours superflus.</item>
        </list>
        <p rend="heading"><lb/>ALCIMADURO</p>
        <lg>
          <l><lb/>Bous nou m'escoutats? bous demourats en plaço ?</l>
          <l><lb/>Ah ! que bous m’alarmats!</l>
        </lg>
        <p rend="heading"><lb/>JEANET</p>
        <list>
          <item>Hélas! Daphnis n'és pus.</item>
        </list>
        <p rend="heading"><lb/>ALCIMADURO</p>
        <lg>
          <l><lb/>Daphnis n'és pus, grand Dius ! Ah ! tout moun sang se glaço.</l>
        </lg>
        <p rend="heading"><lb/>ALCIMADURO</p>
        <p rend="heading"><lb/>Air</p>
        <lg>
          <l><lb/>Daphnis, moun chér Daphnis, per termina toun sort,</l>
          <l><lb/>Qualo ratjo te guido ?</l>
          <l><lb/>Ma rigou te douno la mort</l>
          <l><lb/>E moun amour nou pot te redouna la bido.</l>
        </lg>
        <p rend="heading"><lb/>JEANET</p>
        <lg>
          <l><lb/>Calmo te, ma souréto.</l>
        </lg>
        <p rend="heading"><lb/>ALCIMADURO</p>
        <lg>
          <l><lb/>Yéu soui desésperado ;</l>
        </lg>
        <p rend="heading"><lb/>JEANET</p>
        <list>
          <item>Aco's trop t'anima,</item>
        </list>
        <lg>
          <l><lb/>Tous regréts soun perduts.</l>
        </lg>
        <pb facs="0024.xml"/>
        <ab><lb/> 54 —</ab>
        <ab><lb/>Oublido la tristésso,<lb/>Per ésprouba toun cor éy boulgut t’alarma.<lb/>Perdouno ma finésso.</ab>
        <p rend="heading"><lb/>ALCIMADURO</p>
        <lg>
          <l><lb/>Al noun de Diu, moun frayre,</l>
          <l><lb/>Anen trouba Daphnis, boli lou béyr’encor.</l>
        </lg>
        <p rend="heading"><lb/>JEANET</p>
        <lg>
          <l><lb/>Tu n’y pensos dounc pas, prés d'él que bos tu fayre?</l>
        </lg>
        <p rend="heading"><lb/>ALCIMADURO</p>
        <p><lb/>De soun coutèl boli perça moun cor.</p>
        <p rend="heading"><lb/>JEANET</p>
        <p><lb/>Grand Diu!</p>
        <p rend="heading"><lb/>ALCIMADURO</p>
        <lg>
          <l><lb/>Per fini moun martiro</l>
          <l><lb/>Ségui la ratjo que m’inspiro.</l>
        </lg>
        <p rend="heading"><lb/>SCENO VI</p>
        <p rend="heading"><lb/>DAPHNIS, ALCIMADURO, JEANET</p>
        <p rend="heading"><lb/>ALCIMADURO</p>
        <lg>
          <l><lb/>Ah ! Daphnis n’és pas mor.</l>
        </lg>
        <p rend="heading"><lb/>DAPHNIS</p>
        <list>
          <item>Pastouro, mas amours;</item>
        </list>
        <p rend="heading"><lb/>ALCIMADURO</p>
        <lg>
          <l><lb/>Qual Diu bous rend à ma tendrésso?</l>
        </lg>
        <p rend="heading"><lb/>DAPHNIS</p>
        <lg>
          <l><lb/>Jeanet m’a prestat soun secours.</l>
        </lg>
        <p rend="heading"><lb/>ALCIMADURO à Jeanet</p>
        <lg>
          <l><lb/>Ah ! bous m’abéts troumpado.</l>
        </lg>
        <p rend="heading"><lb/>JEANET</p>
        <p rend="heading"><lb/>ALCIMADURO à Daphnis</p>
        <lg>
          <l><lb/>E’y fayt trop béyre ma feblésso,</l>
        </lg>
        <lg>
          <l><lb/>Per la boulé dissimula.</l>
        </lg>
        <p rend="heading"><lb/>DAPHNIS</p>
        <lg>
          <l><lb/>Ah ! ma félicitat passo moun ésperenço,</l>
          <l><lb/>Pastouro, bous m’aymats, dégnats lou répeta.</l>
        </lg>
        <p rend="heading"><lb/>ALCIMADURO</p>
        <lg>
          <l><lb/>Yéu nou podi pus resista</l>
          <l><lb/>A tant d'amour e de counstenço.</l>
        </lg>
        <pb facs="0025.xml"/>
        <ab><lb/>— 55 —</ab>
        <p rend="heading"><lb/>DAPHNIS, ALCIMADURO</p>
        <p rend="heading"><lb/>Duo</p>
        <lg>
          <l><lb/>N'auréy jamay trop de lezé</l>
          <l><lb/>Per celebra ta bienbéillenço,</l>
          <l><lb/>Amour, ah I qualo récompenço,</l>
          <l><lb/>Moun cor natjo dins lou plazé,</l>
        </lg>
        <p rend="heading"><lb/>JEANET</p>
        <lg>
          <l><lb/>Jantis Pastoureléts, ayci, joust la berduro,</l>
          <l><lb/>Benéts toutis canta l’amour d’Alcimaduro.</l>
        </lg>
        <p rend="heading"><lb/>SCENO VII</p>
        <p rend="heading"><lb/>DAPHNIS, ALCIMADURO, JEANET,<lb/>PASTOUS, PASTOUROS</p>
        <p rend="styled"><lb/>On danso.</p>
        <p rend="heading"><lb/>JEANET E LOU CHOR</p>
        <lg>
          <l><lb/>Lou Diu nenet és un embelinayre ;</l>
          <l><lb/>Dégus nou pot s’en garanti.</l>
          <l><lb/>Lou trét qu’él bol nous fa senti</l>
          <l><lb/>Part de sa ma coum’un ésclayre.</l>
        </lg>
        <p rend="styled"><lb/>On danso</p>
        <p rend="heading"><lb/>ALCIMADURO</p>
        <p rend="heading"><lb/>Air</p>
        <lg>
          <l><lb/>Quand l’amour bol nous emflama,</l>
          <l><lb/>Que sap pla coumo cal s’y prendre;</l>
          <l><lb/>Es tan finét per nous surprendre,</l>
          <l><lb/>Qu’en fadejan sap nous charma.</l>
          <l><lb/>Que sert countr’él de se defendre ?</l>
          <l><lb/>Que sert countr’él de s’anima?</l>
          <l><lb/>Nous cal qu’un moumen per ayma,</l>
          <l><lb/>Nous cal qu’un moumen per se rendre.</l>
        </lg>
        <ab><lb/>On danso,</ab>
        <p rend="heading"><lb/>DAPHNIS</p>
        <lg>
          <l><lb/>Ah! que l'amour abio rasou</l>
          <l><lb/>De blassa ma Pastouréléto.</l>
          <l><lb/>El n’a jamay fayt de counquéto</l>
          <l><lb/>Que posco li fa pu d’aunou.</l>
          <l><lb/>Se dins lou sejour de Cithéro,</l>
          <l><lb/>Se moustrabo moun souleillet;</l>
          <l><lb/>Jusqu’àl pus pichot amourét</l>
          <l><lb/>Bouldrio la prendre per sa méro.</l>
        </lg>
        <fw type="quiremarks"><lb/>On danso</fw>
        <figure type="decoration"/>
      </div>
