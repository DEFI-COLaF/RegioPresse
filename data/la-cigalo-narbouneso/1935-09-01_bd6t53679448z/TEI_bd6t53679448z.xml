  <text>
    <body>
      <div type="article">
        <div>
          <pb facs="0001.xml"/>
          <fw type="runningTitle"><lb/>XIXANNADO</fw>
          <dateline><lb/>Septembre 19</dateline>
          <ab><lb/>BALENTI<lb/>Oui Moussu.<lb/>CABIROU<lb/>Sans cerbèlo I....<lb/>Cadro pas abe l’aire,<lb/>Piotas !...</ab>
          <fw type="numbering">No 211</fw>
          <p rend="heading"><lb/>La TRAPADELO: (Seguido)</p>
          <lg>
            <l><lb/>Ei tort!... probo-me bot I... brigant.</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <p rend="dateline"><lb/>La trapadelo!...</p>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>leï pas coumandat qui marchesse dessus.</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>E soun artel coupat?...</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Tampis per el I... lou gus I....</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Bous ba cresets atal ?....</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <list>
            <item>Que benio rabastraire?...</item>
          </list>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Ba sabi pas Moussu !...</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>De me faïre passa per un inoucentas.</l>
            <l><lb/>Dalhurs quand sara’quis nous entendren.</l>
          </lg>
          <p rend="styled"><lb/>Cabirou sourtits</p>
          <p rend="heading"><lb/>SENOV</p>
          <p rend="heading"><lb/>BALENTI (soulet)</p>
          <lg>
            <l><lb/>Ei bel te mefisa d’aquel paure Canilho.</l>
            <l><lb/>Ja t'i caldra passa coumo'n peïs sus la grilho,</l>
            <l><lb/>Te figures beleu qu’ajen tout preparat,</l>
            <l><lb/>La trapo !... lou temouen, e maï lou passerat,</l>
            <l><lb/>Perque d’un simple mot nous clabes la soupapo,</l>
            <l><lb/>Attend un pauc l’amic beiras coussi l’on trapo</l>
            <l><lb/>Las gens que coumo tu soun pesouls rebenguts,</l>
            <l><lb/>S'acos te costo pas un centenat d’escuts.</l>
            <l><lb/>Boli estre penjat, aprèts faren en sorto...</l>
          </lg>
          <p rend="styled"><lb/>PIERROUNEL. (en deforo)</p>
          <lg>
            <l><lb/>Balenti !...</l>
          </lg>
          <pb facs="0002.xml"/>
          <milestone unit="page" n="130"/>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Que boulèts ?...</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Durbissi-nous la porto.</l>
          </lg>
          <p rend="heading"><lb/>SENO VI</p>
          <p rend="heading"><lb/>BALENTI, PIERROUNNEL, CANILHO</p>
          <p rend="heading"><lb/>PIERROUNEL (en dintran)</p>
          <lg>
            <l><lb/>Ount es lou Cabirou?</l>
          </lg>
          <p rend="heading"><lb/>BaLENtI</p>
          <lg>
            <l><lb/>Se labo lous poumpils.</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Lous poumpils I....</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Oui Moussu !... per abe de regrils,</l>
            <l><lb/>Sioi oubligeat tabes di faire de tisano,</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>De tisano d’agram,</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Nani !... de... milograno !...</l>
            <l><lb/>Me rapeli pas pus la tisano qu’a dit.</l>
            <l><lb/>PIERROUNEL (A Canilho qu’es demourat sus la porto)</l>
            <l><lb/>Lou seren de la neit, t’a un pauc refredit ?...</l>
          </lg>
          <p rend="heading"><lb/>CANILHO</p>
          <lg>
            <l><lb/>Que nou?...</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Alors que fas plantat coumo'no quilho,</l>
            <l><lb/>Semble pages countent, abanssoté Canilho.</l>
            <l><lb/>La c’est ça !... Balenti, beï aïssi que bejen !...</l>
            <l><lb/>Coussi diable faren per y paupa l’argen.</l>
            <l><lb/>Dabort escoutats-me; durbissets las aurèlhos,</l>
            <l><lb/>Sabets que Cabirou n’a pas frèt à las pelhos.</l>
            <l><lb/>Se mefiso de tout ço qui pot arriba...</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Ne sabi prou quicon I...</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Perque posque tiba,</l>
            <l><lb/>Nous i caldra daura brabomen la pillulo.</l>
          </lg>
          <p rend="heading"><lb/>CANILHO</p>
          <lg>
            <l><lb/>De qu’apèles daura?...</l>
          </lg>
          <pb facs="0012.xml"/>
          <milestone unit="page" n="140"/>
          <ab><lb/>PIERROUNEL<lb/>Lou paure Cabirou ne toumbara malaut.<lb/>CABIROU (en dintran)</ab>
          <p rend="styled"><lb/>B'as tout dins lou buffet !...</p>
          <lg>
            <l><lb/>Per beïre se faras un poulit sous-prefet!....</l>
          </lg>
          <p rend="styled"><lb/>(Balenti sourtits)</p>
          <p rend="heading"><lb/>SENO XIII</p>
          <p rend="heading"><lb/>CANILHO, PIERROUNEL</p>
          <p rend="heading"><lb/>CANILHO</p>
          <lg>
            <l><lb/>Cresès qu’aqueste cop reussiren nostr'afaire?...</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Saïo pla malerous e lou bielh roundinaïre,</l>
            <l><lb/>Ne ba rafi lous pots coum’un miol de quarant’ans.</l>
          </lg>
          <p rend="heading"><lb/>CANILHO</p>
          <lg>
            <l><lb/>Quand i demandaran.</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Très ou quatre cents francs</l>
          </lg>
          <p rend="heading"><lb/>CANILHO</p>
          <lg>
            <l><lb/>Pas mai !...</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>I gna pla prou, per nous paga sa bosso.</l>
            <l><lb/>Am’acos pensi pla qu’ont pot faire la noço.</l>
          </lg>
          <p rend="heading"><lb/>CANILHO</p>
          <lg>
            <l><lb/>Metten cent francs de maï e que tout siogue dit.</l>
            <l><lb/>Cresès que Balenti sara prou degourdit,</l>
            <l><lb/>Per fa lou sous prefet?...</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Ba cresi !...</l>
          </lg>
          <p rend="heading"><lb/>CANILHO</p>
          <lg>
            <l><lb/>Dius l'entende !...</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Ne fara toujour prou per fa peta la lende.</l>
          </lg>
          <p rend="heading"><lb/>CANILHO</p>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>El raï !... chut gar l'aissis I...</l>
          </lg>
          <p rend="heading"><lb/>SENO XIV</p>
          <p rend="heading"><lb/>PIERROUNEL, CANILHO, BALENTI</p>
          <p rend="styled"><lb/>Bietase qu’un nigaut.</p>
          <pb facs="0013.xml"/>
          <milestone unit="page" n="141"/>
          <ab><lb/>CABIROU<lb/>PIERROUNEL</ab>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>De qu’as que te fa mal?...</l>
          </lg>
          <lg>
            <l><lb/>Pas res !... Sioï en coulèro !...</l>
            <l><lb/>Ei agachat pertout!... Ei pas res bits I... galèro I....</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Canilho s’es troumpat !... T'ei dit qu'ero lou mal,</l>
            <l><lb/>Que lou fasio parla de trabets.</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <list>
            <item>L'animal,</item>
          </list>
          <lg>
            <l><lb/>Auïo pouscut aumens tene las dens sarrados,</l>
            <l><lb/>Las portos de l’oustal soun toutos pla tampados</l>
            <l><lb/>E coumo teni pas ches ieu de coffre fort</l>
            <l><lb/>Quand disio al secours !...</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <list>
            <item>Ebe?...</item>
          </list>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Ero trop fort!...</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Fort ou nou, as cregut que sautaboun la grilho</l>
            <l><lb/>E près lou fèt a mot d’aquel paure Canilho.</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Es bertat!...</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Moun amic Canilho n’a pas tort!...</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>A perpaus deque fa?.</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Dourmits !... qu'un triste sort.</l>
            <l><lb/>Se beire près pel ped coum’un lapin saubatche</l>
            <l><lb/>I poudro pourta cop, e sustout a soun atche.</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Acos tampis per el !...</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Dabant parel malùr,</l>
            <l><lb/>Lou planisses pajès?...</l>
          </lg>
          <list>
            <item>CABIROU</item>
          </list>
          <lg>
            <l><lb/>Pajès!</l>
          </lg>
          <lg>
            <l><lb/>E qu'un cor dur</l>
          </lg>
          <pb facs="0014.xml"/>
          <milestone unit="page" n="142"/>
          <ab><lb/>Moussu lou Sous-prefet.</ab>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Escouto Pierrounel dins aquesto bidasso,</l>
            <l><lb/>Tout ço qu’on beï de mal deù pas daissa de traço</l>
            <l><lb/>Perdeque fa d’alhurs se fa de michant sanc.</l>
            <l><lb/>Es pas per fantesiè sabes qu’eï lou pel blanc.</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Mès acos probo pas qu’ajes besoun de rire,</l>
            <l><lb/>Dal malùr d’un amic.</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Nou me daisso me dire !...</l>
            <l><lb/>Se parles tout lou temps, auras toujour rasou.</l>
            <l><lb/>Escouto, bal pas res d’estre trop boun garçou,</l>
            <l><lb/>Sabes que sioï testut.</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Ba sabi.</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Perque faïre</l>
            <l><lb/>Sanjaïo de cansou en gardant lou même aïre,</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Poudros pla cependant abe de coumpaçiu.</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>T’eï deja dit un cop qu’acos n’es un leçiu,</l>
            <l><lb/>Que pot pas derusca ma petito bugado,</l>
            <l><lb/>L’ideio qu’es aquis es trop pla rancugnado,</l>
            <l><lb/>Quand sios dintrat t’eï dit que m’èri mes sul pun,</l>
            <l><lb/>Que saïo l'empereur i beio que de fun.</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Es bertat cependant s’a la cambo malauto.</l>
            <l><lb/>L’inquèsto dira be dount es que ben la fauto.</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>L'inquesto qu’es acos ?...</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Assa me siots pas fats?...</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Per counstata lou fèt,</l>
            <l><lb/>Ei dit a Balent baitent juncos la plasso,</l>
            <l><lb/>E meno nous sul cop Moussu de l’aigo grasso</l>
            <l><lb/>E Balent es partit !....</l>
          </lg>
        </div>
      </div>
    </body>
