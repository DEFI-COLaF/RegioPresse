  <text>
    <body>
      <div>
        <pb facs="0003.xml"/>
        <dateline><lb/>FEBRIÈ 1948</dateline>
        <fw type="numbering">C.I.D.O.</fw>
        <fw type="quiremarks"><lb/>XXIIm ANNADO</fw>
        <fw type="numbering">No 248</fw>
        <p rend="heading"><lb/>VIuletos TouLousEncos</p>
        <lg>
          <l><lb/>Mauvos, finos e perfumados,</l>
          <l><lb/>Fregelugos, toutos jalados,</l>
          <l><lb/>Dins lour cartoun agrumelados,</l>
          <l><lb/>Las viuletos, s’en soun anados.</l>
        </lg>
        <lg>
          <l><lb/>Espelidos d’aqueste jour</l>
          <l><lb/>Saran belèu present d’amour ?</l>
          <l><lb/>Nani, s’en van vès la doulour</l>
          <l><lb/>Pourtant lour planhiment de flour.</l>
        </lg>
        <lg>
          <l><lb/>Un amic de l’ouro negrouso</l>
          <l><lb/>Las a mandat, oufrendo blouso,</l>
          <l><lb/>Vès lou trespas, la peno afrouso</l>
          <l><lb/>Pourta risoulet de Toulouso !...</l>
        </lg>
        <lg>
          <l><lb/>Dins lou carniè de soun aujol,</l>
          <l><lb/>Lou paire qu'en portoun lou dol,</l>
          <l><lb/>A frusit, demest soun lençol,</l>
          <l><lb/>D'un remembre gaudjous e fol.</l>
        </lg>
        <lg>
          <l><lb/>S’es brembat la seuno jouvenço,</l>
          <l><lb/>Quand se cargabo de sapienço</l>
          <l><lb/>A Toulouso, cap de prouvenço</l>
          <l><lb/>Qu’i daissèt douço souvenenço !...</l>
        </lg>
        <lg>
          <l><lb/>Per lou paire que tant m’es car</l>
          <l><lb/>Pregats, flour dal perfum de par</l>
          <l><lb/>Tu, mimosas dal païs clar,</l>
          <l><lb/>Ulhèt nascut proche la mar.</l>
        </lg>
        <lg>
          <l><lb/>Mai tu viuleto pietadouso</l>
          <l><lb/>Per faire soun amo gaudjouso</l>
          <l><lb/>En nostro lengo tant goustouso</l>
          <l><lb/>Parlats-i de temps de Toulouso.</l>
        </lg>
        <ab><lb/>Mmo PONROUCH-PEtIT.</ab>
        <pb facs="0004.xml"/>
        <milestone unit="page" n="18"/>
        <p rend="heading"><lb/>Lou Charlatan e lous dous singes</p>
        <figure type="decoration"/>
        <lg>
          <l><lb/>Un Charlatan que per ganha sa vido,</l>
          <l><lb/>Roudabo fieiros e mercats ;</l>
          <l><lb/>N’abio per toutis resultats</l>
          <l><lb/>Que sa bourso toujours mai vido.</l>
          <l><lb/>Dins l'idèo de se refa,</l>
          <l><lb/>Mès sustout per faire tourna</l>
          <l><lb/>A sa baraco desertado</l>
          <l><lb/>La clientèlo destacado</l>
          <l><lb/>Croumpèt dous singes jouvenets</l>
          <l><lb/>Que faguèt passa per nanets,</l>
          <l><lb/>L'un un goujat, l'autre uno filho,</l>
          <l><lb/>Nascut de la memo familho.</l>
          <l><lb/>Ame grand souèn les elevèt</l>
          <l><lb/>Les ensenhèt, les etsersèt</l>
          <l><lb/>A milo tours, a milo dansos,</l>
          <l><lb/>Valsos, polkas e countrodansos.</l>
          <l><lb/>Les nanets, vestits richoment</l>
          <l><lb/>Escoutaboun doucilloment.</l>
          <l><lb/>Le mèstre a la porto d'intrado,</l>
          <l><lb/>I fasio faire la parado.</l>
          <l><lb/>— Que soun adreits e mainadets,</l>
          <l><lb/>Aquelis petits dous nanets,</l>
          <l><lb/>Dision en passant les badaires</l>
          <l><lb/>Coumo ba soun laumens les fieirejaires.</l>
          <l><lb/>— Segur, soun d’un païs qu’es das pus avançats ;</l>
          <l><lb/>Les pichounets d’aici soun pas tant avisats.</l>
          <l><lb/>— Soun d'uno raço qu’es unico,</l>
          <l><lb/>Disio lou charlatan redoublant sa musico.</l>
          <l><lb/>Un jouvent curious e rusat,</l>
          <l><lb/>De la troumpariè se doutabo</l>
          <l><lb/>E per descourbi la vertat,</l>
          <l><lb/>Lanço d’anougos que pourtabo.</l>
          <l><lb/>A quatre patos lous sinjous</l>
        </lg>
        <pb facs="0005.xml"/>
        <milestone unit="page" n="19"/>
        <lg>
          <l><lb/>Abandounoun la countrodanso</l>
          <l><lb/>E sus la nouvelo pitanço</l>
          <l><lb/>D’un saut s’abatoun toutis dous.</l>
          <l><lb/>De toutos lours dents agusados</l>
          <l><lb/>Crèboun l’anougo vitoment</l>
          <l><lb/>E lours minos afiroulados</l>
          <l><lb/>Mostroun pla lour countentoment.</l>
          <l><lb/>Les passants amusats risoun de l'avanturo</l>
          <l><lb/>En fèt de danso, les nanets</l>
          <l><lb/>Courrissoun a petits sautets</l>
          <l><lb/>Coumo fan singes de naturo.</l>
          <l><lb/>La musico s’arrèsto net;</l>
          <l><lb/>Adius la famouso parado.</l>
          <l><lb/>Le charlatan a perdut soun toupet,</l>
          <l><lb/>Sa blago n'es paralisado.</l>
          <l><lb/>Sa ruso n’a pas reussit :</l>
          <l><lb/>Perdut espèr, perdut proufit.</l>
          <l><lb/>La fourtuno tant desirado</l>
          <l><lb/>Un cop de mai s'es envoulado.</l>
        </lg>
        <note>
          <p rend="styled"><lb/>...............</p>
        </note>
        <lg>
          <l><lb/>Un troumpur es souvent troumpat</l>
          <l><lb/>E tard ou d’ouro denounçat;</l>
          <l><lb/>E sa messourgo descouverto</l>
          <l><lb/>Le meno toujours a sa perto.</l>
        </lg>
        <p rend="styled"><lb/>C.-A. DE CARCASSOUNO.</p>
        <figure type="decoration"/>
        <p rend="heading"><lb/>FABLO OMNIBUS</p>
        <lg>
          <l><lb/>La vesèts aquelo jouvento?</l>
          <l><lb/>A pas uno caro plasento,</l>
          <l><lb/>Mes s’es pas poulido, aquo rai ;</l>
          <l><lb/>Per agrada, ten quicon mai...</l>
          <l><lb/>A fosso argent ? —N'a en abounde ?</l>
          <l><lb/>Qual ba dit ? Un que s’i couneis...</l>
          <l><lb/>— Vesèts, souvent dins aquel mounde</l>
          <l><lb/>Val mai la salço que lou peis.</l>
        </lg>
        <pb facs="0015.xml"/>
        <milestone unit="page" n="29"/>
        <p rend="heading"><milestone unit="column" n="1"/><lb/>Crounico d’Istorio Loucalo</p>
        <figure type="decoration"/>
        <p rend="heading"><lb/>Las descouvertos de St-Paul de Narbouno (Seguido)</p>
      </div>
      <div type="article">
        <figure type="decoration"/>
        <p><lb/>L’an passat abiom clavat per quauquis temps la pichoto<lb/>crounico sus las foulhos de St-Paul de Narbouno. Esperabem<lb/>poude vous counta bei de belos causos e vous parla de nouvèlos<lb/>descouvertos meravilhousos, mes M. Joucla, l’entrepreneire das<lb/>mounuments istouriques nous a jougat un brabe tour : al loc de<lb/>trauca a tout tampat ! Aquo fa que se bei pas res mai. Urouso-<lb/>ment que durara pas e dins pauc de temps en la, poudrem visita<lb/>dins l’endisou de la terro nostre bèl cementèri paleo-crestia per<lb/>toujours salvat de la destrucciu.</p>
        <p><lb/>Dous nouvelis sarcoufages en peiro soun estat descouverts<lb/>ame uno meno de sepulturos faitos ame de lausos e dous doulhs<lb/>en terro gèlo dount un abio servat lous osses d’un tout petit mai-<lb/>nachou. Es tout.</p>
        <p><lb/>Sioi ana interviouva (coumo disoun lous Francimands)<lb/>M. Joucla, que m’a dit que tout èro leng d’estre finit e que las<lb/>foulhos sarion perseguidos joust lou garage de Moussu lou Curat<lb/>car d’aquel coustat se pod pas encaro veire ount finits la cella<lb/>memoriæ.</p>
        <p><lb/>Cresem que la perseguido d’aquelos foulhos permetra<lb/>encaro de descouvertos espectaclousos e gardam l’espèr que<lb/>de l’endisou de la terro surgiran encaro quauquos pajos de l’isto-<lb/>rio anciano de nostre vièlh Narbouno.</p>
        <p><lb/>A-n’aquel moument poudèts estre assegurats que la pi-<lb/>choto crounico sur las foulhos de St-Paul de Narbouno se tour-<lb/>nara dourbi.</p>
        <ab><milestone unit="column" n="2"/><lb/>L. PONCIN.</ab>
        <pb facs="0016.xml"/>
        <milestone unit="page" n="30"/>
      </div>
      <div type="article">
        <head><lb/>Lo<lb/></head>
        <figure type="decoration"/>
        <lg>
          <l><lb/>Milou, dit Carbassot, cantabo naut e fals</l>
          <l><lb/>Sa vouts tindanto e trounadisso</l>
          <l><lb/>Aurio fai toumba de granisso</l>
          <l><lb/>Se Dius lou paire, aquelis jours,</l>
          <l><lb/>Ero pas estat das pus sourds I</l>
          <l><lb/>De canta dins uno capèlo</l>
          <l><lb/>L’abio pas fait veni devot,</l>
          <l><lb/>E dision : « que mai d’uno bèlo,</l>
          <l><lb/>» De soun amour èro lou clot. »</l>
          <l><lb/>Sant-Peire ne tenio lou registre...</l>
          <l><lb/>Tabès, quand Milou cluguèt l’elh</l>
          <l><lb/>E se presentèt al Menistre</l>
          <l><lb/>Que gardo las portos dal Cèl,</l>
          <l><lb/>Aiceste diguèt: «Siots lou Chantre</l>
          <l><lb/>» De la capèlo de Salza ?»</l>
          <l><lb/>— «Oui sioi lou Chantre !» — «Diantre, diantre...</l>
          <l><lb/>» Vous ei jamai ausi canta !</l>
          <l><lb/>» Anats pus leng! » Al purgatori,</l>
          <l><lb/>Sioguèt la memo recepciu...</l>
          <l><lb/>E, dins l'Infern, lou paure estori</l>
          <l><lb/>Se recatèt mai mort... que viu!</l>
          <l><lb/>L'istorio es claro coumo l'veire !</l>
          <l><lb/>Se cal pas fourça lou cervèl.</l>
          <l><lb/>Mès lou reprouverbi es de creire:</l>
        </lg>
        <p rend="styled"><lb/>« Bram d’ase mounto pas al Cèl!»</p>
        <p rend="styled"><lb/>LOUIS BOUSQUET, Mestre en Gai Sabe.</p>
        <figure type="decoration"/>
        <p rend="heading"><milestone unit="column" n="1"/><lb/>PER RIRE</p>
        <p><lb/>Sus terro abem agut l'age de la peiro, l'age dal ferre, l'age<lb/>d'or, de l'automobilo, dal cinema, de l'avioun... aro siom a<lb/>a l'age atoumic !</p>
        <p><lb/>Toutis lous ages passoun... Un soul es eternal : « L’age<lb/>das coulhouns!»</p>
        <pb facs="0017.xml"/>
        <milestone unit="page" n="31"/>
        <lg>
          <l><lb/>Es partit boun matis malgrat la frèd que pèlo</l>
          <l><lb/>En faguent un bruch agre ame soun trigounet,</l>
          <l><lb/>Pei l’ei vist dins lou camp marcha draguet draguet,</l>
          <l><lb/>E tenio de virat coumo viro uno bèlo.</l>
        </lg>
        <lg>
          <l><lb/>La terro lou couneis; que fague caut ou fred</l>
          <l><lb/>Es aqui de coutunh sans agacha l’estèlo ;</l>
          <l><lb/>De soun bras cado jour qual sap ço qu'encantèlo</l>
          <l><lb/>En semenant lou blad que mounto naut e drèt.</l>
        </lg>
        <lg>
          <l><lb/>Gracios a tu Bouiè, la misèro s’espaço!</l>
          <l><lb/>Ame tu siom segur de counserva la raço,</l>
          <l><lb/>La Familho, l’ounou, e lou soutoul mannat.</l>
        </lg>
        <lg>
          <l><lb/>Franço, renaissiras encaro noblo e grando I</l>
          <l><lb/>Lou Bouiè ten en ma la barro de coumando,</l>
          <l><lb/>Trabalho pel debert e per l'umanitat.</l>
        </lg>
        <ab><lb/>A. MACABIÈS </ab>
        <figure type="decoration"/>
        <lg>
          <l><lb/>Aquel jour, per Jousep la chanço caminabo.</l>
          <l><lb/>Taloment pla que ganhèt soun prouçès;</l>
          <l><lb/>A l’avoucat que lou representabo,</l>
          <l><lb/>En sourtiguent, diguèt : « A pas de prèts</l>
          <l><lb/>Vostro faissou de mena moun afaire... »</l>
          <l><lb/>— Vertat ? Faguèt lou Mestre encatelaire,</l>
          <l><lb/>Mes, coumo ei pla counescut vostre paire.</l>
          <l><lb/>Vous'n coustara que trento milo francs...</l>
          <l><lb/>Jousep pensabo, en paupant sa bourseto,</l>
          <l><lb/>« Alors ! S'abio counescut lou papeto !...»</l>
        </lg>
        <figure type="decoration"/>
      </div>
    </body>
  </text>
