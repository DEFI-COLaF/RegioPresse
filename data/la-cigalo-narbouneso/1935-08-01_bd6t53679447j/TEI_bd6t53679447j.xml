  <text>
    <body>
      <div type="article">
        <div>
          <pb facs="0004.xml"/>
          <milestone unit="page" n="116"/>
          <head><lb/>CABIROU</head>
          <lg>
            <l><lb/>Que t'ei dit?....</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Me ba rapeli pas!...</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Bougre d’estabousit.</l>
            <l><lb/>T'ei dit que boulho pas beur' aquelo tisano...</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>De cougos de caulets?...</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <list>
            <item>E nou !... de milograno !...</item>
          </list>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Alors deque boulets !...</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Quicon per adoussi!.</l>
            <l><lb/>Mous bouïèus enflambats que sentissi tourssi</l>
            <l><lb/>Faras escouto-me sus las grandos chambrièros,</l>
            <l><lb/>Bouli un grand bolat de cougos de cerièros</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Oui me per fair'acos cal aluma lou foc,</l>
            <l><lb/>E n’ei pas souloment la mitat d’un tanoc.</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Asclaras lou fautùr pourrit, qu’es a la cabo.</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Lou fautùr?...</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <p rend="heading"><lb/>M'as pas dit que lou cussou l'acabo ?...</p>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Si fait!....</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Alors perque lou tene rejunit</l>
            <l><lb/>Asclo lou Balenti, e que siogue fenit.</l>
            <l><lb/>L'asclaras?...</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Oui Moussu !....</l>
          </lg>
          <p rend="styled"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Biatase qu'uno caro,</l>
          </lg>
          <pb facs="0005.xml"/>
          <milestone unit="page" n="117"/>
          <fw type="runningTitle"><lb/>Deques que as?...</fw>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>A Moussu I... uno pièço tant raro,</l>
            <l><lb/>Un fautur qu’ès tant bielh tout escultat, a pans,</l>
            <l><lb/>Segur que deù abe très ou quatre cents ans.</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>E deque te pot fa ?...</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Parès Moussu...</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <p rend="heading"><lb/>Caucagno</p>
          <lg>
            <l><lb/>Ba cresi, quand saio dal grandas Carlomagno,</l>
            <l><lb/>De Capet, de Pepin, ou d’un rei pla mai biel,</l>
            <l><lb/>Me lou metras al foc sabes sans rafi l’èl,</l>
            <l><lb/>Mas ausit?...</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <p rend="heading"><lb/>Oui Moussu.</p>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Sabès que lou tems passo,</l>
            <l><lb/>Dins miejour'a pus prèts, me pourtaras la tasso,</l>
            <l><lb/>Sucrado coumo cal maï enfusad' a pun.</l>
            <l><lb/>Doublides pas tabes de descendre lou lun</l>
          </lg>
          <p rend="styled"><lb/>(calcun souno deforo)</p>
          <lg>
            <l><lb/>Aï aro I... quès acos?....</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Moussu calcun que souno.</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Bei ausit !... bei ausit !... quès aquelo bourouno</l>
            <l><lb/>Que se ben encranca al moument d’an'al leit?...</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Ba sabi pas Moussu.</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Per beni dins la neit</l>
            <l><lb/>Derenga lou malaut que bol estre tranquille.</l>
            <l><lb/>Cal abe de rasous, bertad l’ome doucille.</l>
          </lg>
          <p rend="styled"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Ba sabi pas Moussu.</l>
          </lg>
          <pb facs="0006.xml"/>
          <milestone unit="page" n="118"/>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Acos m’espanto pas,</l>
            <l><lb/>Es mèmes estounant que sapies march’al pas.</l>
            <l><lb/>M’agachàs?...</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <p rend="heading"><lb/>Oui Moussu!...</p>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>As bel rafi la cilho,</l>
            <l><lb/>Anen baï t'en durbi sauras cal es qu’esquilho.</l>
            <l><lb/>(al moument ount Balenti ba sourti Pierrounel dintro).</l>
          </lg>
          <p rend="heading"><lb/>SENO II</p>
          <p rend="heading"><lb/>CABIROU, BALENTI, PIERROUNEL</p>
          <p rend="heading"><lb/>PIERROUNEL (en dintran)</p>
          <lg>
            <l><lb/>Bounsouer I....</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Tè Pierrounel.</l>
          </lg>
          <p rend="heading"><lb/>PieRROUNEL</p>
          <lg>
            <l><lb/>Coussi ba la santat</l>
            <l><lb/>CABIROU</l>
          </lg>
          <lg>
            <l><lb/>Enfin!....</l>
          </lg>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Sios malautis?..</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <p rend="heading"><lb/>E,o,</p>
          <list>
            <item>BALENTI (a part)</item>
          </list>
          <ab><lb/>N'es espantat !....</ab>
          <p rend="heading"><lb/>CABIROU (à Balenti)</p>
          <lg>
            <l><lb/>Dequ'as dit?....</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <list>
            <item>leu parès,</item>
            <item>CABIROU (à Pierrounel)</item>
            <item>Gacho qu’uno figuro,</item>
          </list>
          <p rend="heading"><lb/>PIERROUNEL</p>
          <lg>
            <l><lb/>Sios toucat Cabirou?...</l>
          </lg>
          <pb facs="0016.xml"/>
          <milestone unit="page" n="128"/>
          <ab><lb/>Ja ba beirets Moussu<lb/>Tu creses que Canilho,<lb/>Me boudra pas pagà lou barreù de la grilho?...<lb/>Acos es tout bits ; d’abort<lb/>Bous estounarei pas, en diguen qu’abets tort.</ab>
          <p rend="heading"><lb/>BALENTI</p>
          <p rend="heading"><lb/>Lou malerous beleù qu’a pas soupat.</p>
          <p rend="heading"><lb/>CABIROU</p>
          <p rend="heading"><lb/>Tout acos !... tout acos !... n’es que de farlabicos,<lb/>S'a pas soupat tampis, aura pas de coulicos.</p>
          <p rend="heading"><lb/>BaLENTI</p>
          <lg>
            <l><lb/>Alors bous figurats qu’acos passara’tal</l>
            <l><lb/>Lou pauras?...</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Ta milhou !...</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <p rend="heading"><lb/>Ne tastarets un talI...</p>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Un tal?....</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>E oui Moussu.</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Acos es dùr à creire,</l>
            <l><lb/>Sioi pas nascut curious me ba boudro pla beire.</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Bietase qu’un petart,</l>
            <l><lb/>Faguès pas tant de bruch. Calho-te grand babart.</l>
          </lg>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Alors bous figurats....</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <p rend="heading"><lb/>BALENTI</p>
          <lg>
            <l><lb/>Tout just.</l>
          </lg>
          <p rend="heading"><lb/>CABIROU</p>
          <p rend="heading"><lb/>Ba beiren be!....</p>
          <p rend="heading"><lb/>BALENTI</p>
          <p rend="heading"><lb/>CABIROU</p>
          <lg>
            <l><lb/>Que ieù ei tort falourt I....</l>
          </lg>
          <p rend="styled"><lb/>(A Segui).</p>
          <lg>
            <l><lb/>Lou Gerent: J. Lombard. - Estampariè dal Lengodoc, Narbouno.</l>
          </lg>
          <ab>
            <stamp><lb/>C.I.B.O.<lb/>ZIERS</stamp>
          </ab>
        </div>
      </div>
    </body>
